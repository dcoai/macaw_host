#!/usr/bin/env elixir
#
# <%= @script %> — manage the <%= @title %> container on a deployment host.
#
# Generated by `mix macaw.host.ctl` (macaw_host) from the generic modules it
# ships and <%= @title %>'s own commands (`Ctl.AppCommands`). Change those and
# regenerate; never edit this file by hand: `mix macaw.host.ctl --check`
# fails CI when the two differ.
#
# A single-file Elixir script: only the standard library, no Mix project, no
# dependencies. The host needs docker and Elixir 1.18 or newer on PATH, and
# nothing else. `./<%= @script %> help` lists the commands and the settings.
#
# Everything this host keeps for <%= @title %> lives in one data directory,
# named by the `@data_dir` line below — the only line of this file that is
# yours:
#
<% conf = "<data_dir>/#{@name}.conf"; pad = String.duplicate(" ", String.length(conf)) %>#     <%= conf %>   host settings: image, port, network …  (env)
#     <%= String.pad_trailing("<data_dir>/data/", String.length(conf)) %>   the container's <%= @container_data %>: <%= @title %>'s own
#     <%= pad %>   config.exs, its database, its files …  (config)
#
# `./<%= @script %> init` sets it; `./<%= @script %> update` carries it into the
# new script. This script ships inside the image, so a host can get it with:
#
#     docker run --rm <%= @image %>:<%= @tag %> \
#       bin/ctl > <%= @script %> && chmod +x <%= @script %> && ./<%= @script %> init
#
# Extract it by hand only once: after that `./<%= @script %> update` replaces it
# and keeps the `@data_dir` line (and the previous copy as <%= @script %>.bak);
# a hand re-extraction does not.

# Checked before any module is defined, so a host with an old Elixir gets one
# clear sentence rather than an UndefinedFunctionError from the middle of a
# command. `JSON` arrived with 1.18.
unless Version.match?(System.version(), ">= 1.18.0") and Code.ensure_loaded?(JSON) do
  IO.puts(:stderr, """
  <%= @script %> needs Elixir 1.18 or newer (for its JSON module); this is Elixir #{System.version()}.

  Install a current Elixir (https://elixir-lang.org/install.html), then run
  this again.
  """)

  System.halt(1)
end

defmodule Ctl.Home do
  @moduledoc false
  # Set by `./<%= @script %> init`; carried into the new script by `update`.
  @data_dir nil
  def data_dir, do: @data_dir
end

defmodule Ctl.App do
  @moduledoc """
  What this script manages: everything app-specific the generic modules
  need, from the `:ctl` description in <%= @title %>'s mix.exs. The
  generic modules ask here rather than spelling the app's name, and
  `Ctl.AppCommands` may too.
  """

  def name, do: <%= inspect(@name) %>
  def title, do: <%= inspect(@title) %>
  def script, do: <%= inspect(@script) %>

  @doc "The prefix of the variables the release reads: `<PREFIX>_CTL_ARGS` and the like."
  def prefix, do: <%= inspect(@env_prefix) %>

  @doc "The release module whose `config/0` and `status/0` the script calls."
  def release, do: <%= inspect(@release) %>

  @doc "The release's start script inside the image."
  def release_bin, do: <%= inspect(@release_bin) %>

  @doc "Where the data volume is mounted inside the container."
  def container_data, do: <%= inspect(@container_data) %>

  @doc "The port the app listens on inside the container."
  def container_port, do: <%= inspect(Integer.to_string(@port)) %>

  @doc "The fixed uid and gid of the user the app runs as in the image."
  def ids, do: <%= inspect(@ids) %>

  @doc "The data directory `init` offers when asked without one."
  def default_home, do: <%= inspect(@data_home) %>

  @doc "Seconds `stop` gives the app to shut down cleanly."
  def stop_timeout, do: <%= inspect(Integer.to_string(@stop_timeout)) %>

  @doc """
  The host settings and their defaults, in the order `<%= @name %>.conf`
  lists them: the seven every app has, then the app's own.
  """
  def settings, do: <%= inspect(@settings, limit: :infinity, printable_limit: :infinity) %>

  @doc """
  The app config `init` seeds when it is still at its default: a config key
  and `:hostname`, `:timezone` or a literal value.
  """
  def seeds, do: <%= inspect(@seeds, limit: :infinity, printable_limit: :infinity) %>

  @doc """
  What `init --migrate` carries from an older script's `<%= @name %>-env`
  into the app config: `{old key, config key, the old script's default}`,
  the default being nil, `:hostname`, `:timezone` or a string.
  """
  def migrate_keys, do: <%= inspect(@migrate_keys, limit: :infinity, printable_limit: :infinity) %>

  @doc """
  Whether NETWORK may be `host`. `false` keeps the app's listeners off the
  host's interfaces (a console bound inside the container, say).
  """
  def host_network?, do: <%= inspect(@host_network) %>

  @doc """
  Names that are <%= @title %>'s own configuration, not host settings:
  `{"KEY", "config key"}`, refused by `env set`.
  """
  def app_keys, do: <%= inspect(@app_keys, limit: :infinity, printable_limit: :infinity) %>
end

# Structure: `Ctl.App` is what the script manages; `Ctl.Script` reads and
# rewrites the `@data_dir` line; `Ctl.Env` reads and edits the host
# settings; `Ctl.Secret` decides what may be printed; `Ctl.World` is the one
# place that touches the host (commands, sleep, the terminal); `Ctl.Docker`
# builds every docker command line; `Ctl.Commands` are the common
# subcommands, `Ctl.AppCommands` <%= @title %>'s own; `Ctl.main/1` dispatches.
# Tests load this file with `Code.require_file/1` after putting
# `:ctl_no_main` in the process dictionary, which keeps `main/1` from
# running, and swap `Ctl.World` for `Macaw.Host.Ctl.Recorder`, so every
# command's exact docker argv is asserted without docker on the box.
