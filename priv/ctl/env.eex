defmodule Ctl.Env do
  @moduledoc """
  The host settings: what docker needs to run the container, and nothing
  the application itself uses (that is `config`, on the data volume).
  Built-in defaults, then `<data_dir>/<%= @name %>.conf`, then the
  environment, each beating the one before. A value that is empty counts as
  unset at every level.

  The file is plain `KEY=value` lines. Blank lines and `#` comments are
  skipped; a value may be wrapped in double or single quotes. `env set` and
  `env unset` edit the file's own text one line at a time (`edit_set/3`,
  `edit_unset/2`), so a comment someone wrote survives every edit.
  """

  defstruct values: %{},
            file_values: %{},
            sys_values: %{},
            extra: [],
            script: nil,
            data_dir: nil,
            path: nil,
            loaded?: false,
            self_updated?: false

  @file_name "<%= @name %>.conf"

  def keys, do: Enum.map(Ctl.App.settings(), &elem(&1, 0))

  @doc """
  What an older script's `<%= @name %>-env` held that is now the app's own
  configuration: old key to config key.
  """
  def app_keys, do: Map.new(Ctl.App.migrate_keys(), fn {old, key, _} -> {old, key} end)

  @doc """
  Reads the data directory from the script (or `<PREFIX>_DATA_DIR`), then
  its settings file when there is one, resolving every key against the
  environment and the defaults.
  """
  def load(script, sys_env) do
    with {:ok, dir} <- script_data_dir(script) do
      with_data_dir(
        %__MODULE__{
          script: script,
          self_updated?: sys_env[Ctl.App.prefix() <> "_CTL_SELF_UPDATED"] == "1"
        },
        present(sys_env[Ctl.App.prefix() <> "_DATA_DIR"]) || dir,
        sys_env
      )
    end
  end

  @doc "The settings for `dir`: what `init` switches to once it has one."
  def with_data_dir(%__MODULE__{} = env, dir, sys_env) do
    path = dir && Path.join(dir, @file_name)

    with {:ok, file_values, extra} <- read_file(path) do
      {:ok,
       %{
         env
         | data_dir: dir,
           path: path,
           values: resolve(file_values, sys_env),
           file_values: file_values,
           sys_values: for(key <- keys(), value = present(sys_env[key]), into: %{}, do: {key, value}),
           extra: extra,
           loaded?: path != nil and File.exists?(path)
       }}
    end
  end

  defp resolve(file_values, sys_env) do
    Map.new(keys(), fn key ->
      {key, present(sys_env[key]) || present(file_values[key]) || default(key)}
    end)
  end

  # A script that is not on disk (a test's) has the compiled line.
  defp script_data_dir(script) do
    case File.read(script) do
      {:ok, text} -> Ctl.Script.data_dir(text)
      {:error, :enoent} -> {:ok, Ctl.Home.data_dir()}
      {:error, reason} -> {:error, "cannot read #{script}: #{:file.format_error(reason)}"}
    end
  end

  def get(%__MODULE__{values: values}, key), do: Map.fetch!(values, key)

  def ref(env), do: get(env, "IMAGE") <> ":" <> get(env, "TAG")

  @doc "The container's data volume on the host."
  def data_path(%__MODULE__{data_dir: dir}), do: Path.join(dir, "data")

  @doc "The settings file an older script kept beside itself."
  def legacy_path(%__MODULE__{script: script}),
    do: Path.join(Path.dirname(script), Ctl.App.name() <> "-env")

  @doc "Host networking: the app listens on the host's PORT directly."
  def host_network?(env), do: get(env, "NETWORK") == "host"

  @doc "Where a value came from: `:environment`, `:file` or `:default`."
  def source(%__MODULE__{} = env, key) do
    cond do
      Map.has_key?(env.sys_values, key) -> :environment
      present(env.file_values[key]) -> :file
      true -> :default
    end
  end

  @doc """
  Checks the values a command is about to use, returning `:ok` or the first
  problem as `{:error, message}`, before anything is written or run.
  """
  def validate(%__MODULE__{} = env) do
    port = get(env, "PORT")

    cond do
      not port?(port) ->
        {:error, "PORT must be a port number (1–65535), not #{inspect(port)}"}

      not Regex.match?(~r/^[A-Za-z0-9][A-Za-z0-9_.-]*$/, get(env, "NAME")) ->
        {:error, "NAME must be a valid container name (letters, digits, _ . -)"}

      get(env, "NETWORK") == "" ->
        {:error, "NETWORK must be host or the name of a docker network"}

      true ->
        :ok
    end
  end

  defp port?(value) do
    case Integer.parse(value) do
      {n, ""} -> n in 1..65_535
      _ -> false
    end
  end

  @doc "A key as the file may spell it: a shell-style identifier."
  def valid_key?(key), do: Regex.match?(~r/^[A-Za-z_][A-Za-z0-9_]*$/, key)

  @doc """
  The file's text with `key` set to `value`. An active `KEY=` line is
  replaced where it stands; failing that, a commented-out `# KEY=` line is
  taken over; failing that, the line is appended. Every other byte stays.
  """
  def edit_set(text, key, value) do
    line = key <> "=" <> quote_value(value)
    lines = split_lines(text)

    cond do
      index = Enum.find_index(lines, &active_line?(&1, key)) ->
        lines |> List.replace_at(index, line) |> join_lines(text)

      index = Enum.find_index(lines, &placeholder_line?(&1, key)) ->
        lines |> List.replace_at(index, line) |> join_lines(text)

      true ->
        ensure_trailing_newline(text) <> line <> "\n"
    end
  end

  @doc """
  The file's text without any active `KEY=` line, and how many were
  removed. A commented placeholder is a comment and stays.
  """
  def edit_unset(text, key) do
    lines = split_lines(text)
    kept = Enum.reject(lines, &active_line?(&1, key))
    {join_lines(kept, text), length(lines) - length(kept)}
  end

  defp active_line?(line, key), do: Regex.match?(~r/^\s*(?:export\s+)?#{key}=/, line)
  defp placeholder_line?(line, key), do: Regex.match?(~r/^\s*#\s*#{key}=/, line)

  # A file ending in a newline splits into a trailing "" that must not
  # become a blank line; it is put back by `join_lines/2`.
  defp split_lines(""), do: []
  defp split_lines(text), do: text |> String.trim_trailing("\n") |> String.split("\n")

  defp join_lines([], _text), do: ""

  defp join_lines(lines, text),
    do: Enum.join(lines, "\n") <> if(String.ends_with?(text, "\n"), do: "\n", else: "")

  defp ensure_trailing_newline(""), do: ""

  defp ensure_trailing_newline(text),
    do: if(String.ends_with?(text, "\n"), do: text, else: text <> "\n")

  @doc "Reads a settings file: `{:ok, known, extra}`, empty when there is none."
  def read_file(nil), do: {:ok, %{}, []}

  def read_file(path) do
    case File.read(path) do
      {:ok, text} -> parse(text, Path.basename(path))
      {:error, :enoent} -> {:ok, %{}, []}
      {:error, reason} -> {:error, "cannot read #{path}: #{:file.format_error(reason)}"}
    end
  end

  @doc """
  Parses a settings file's text into `{:ok, known, extra}`: the values of
  the known keys, and the `{key, value}` pairs of any other keys in file
  order. `name` names the file in errors.
  """
  def parse(text, name \\ @file_name) do
    known_keys = keys()

    text
    |> String.split(~r/\r?\n/)
    |> Enum.with_index(1)
    |> Enum.reduce_while({:ok, %{}, []}, fn {line, no}, {:ok, known, extra} ->
      case parse_line(line) do
        :skip ->
          {:cont, {:ok, known, extra}}

        {:ok, key, value} ->
          if key in known_keys,
            do: {:cont, {:ok, Map.put(known, key, value), extra}},
            else: {:cont, {:ok, known, extra ++ [{key, value}]}}

        :error ->
          {:halt, {:error, "#{name} line #{no} is not KEY=value: #{String.trim(line)}"}}
      end
    end)
  end

  defp parse_line(line) do
    trimmed = String.trim(line)

    cond do
      trimmed == "" or String.starts_with?(trimmed, "#") ->
        :skip

      match = Regex.run(~r/^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$/, trimmed) ->
        [_, key, raw] = match
        {:ok, key, unquote_value(String.trim(raw))}

      true ->
        :error
    end
  end

  defp unquote_value(raw) do
    cond do
      String.length(raw) >= 2 and String.starts_with?(raw, "\"") and String.ends_with?(raw, "\"") ->
        raw |> String.slice(1..-2//1) |> String.replace("\\\"", "\"")

      String.length(raw) >= 2 and String.starts_with?(raw, "'") and String.ends_with?(raw, "'") ->
        String.slice(raw, 1..-2//1)

      true ->
        # An unquoted value ends where a comment starts, as in a shell.
        raw |> String.split(~r/\s+#/, parts: 2) |> hd() |> String.trim()
    end
  end

  @doc """
  The file's text for a set of values. Every known key present in `values`
  is written, in the order of `keys/0`, each after the sentence that
  explains it; keys this script does not know are kept at the end.
  """
  def render(values, extra \\ []) do
    known =
      Ctl.App.settings()
      |> Enum.filter(fn {key, _, _} -> Map.has_key?(values, key) end)
      |> Enum.map_join("\n", fn {key, _, help} ->
        comment(help) <> key <> "=" <> quote_value(values[key])
      end)

    header() <> known <> "\n" <> render_extra(extra)
  end

  defp comment(""), do: ""

  defp comment(help) do
    "\n" <> (help |> String.split("\n", trim: true) |> Enum.map_join(&("# " <> &1 <> "\n")))
  end

  defp render_extra([]), do: ""

  defp render_extra(extra) do
    "\n# Other settings, kept as they were.\n" <>
      Enum.map_join(extra, "", fn {key, value} -> key <> "=" <> quote_value(value) <> "\n" end)
  end

  defp quote_value(value) do
    if value == "" or Regex.match?(~r/[\s#"']/, value),
      do: "\"" <> String.replace(value, "\"", "\\\"") <> "\"",
      else: value
  end

  defp header do
    """
    # Host settings for <%= @script %>: how docker runs the <%= @title %>
    # container, one KEY=value per line. <%= @title %>'s own configuration is
    # not here: see `./<%= @script %> config list`.
    #
    # Blank lines and # comments are ignored; quotes around a value are
    # optional. A variable set in the environment still wins for a one-off:
    #
    #     PORT=8080 ./<%= @script %> start
    """
  end

  defp default(key) do
    {_, value, _} = List.keyfind(Ctl.App.settings(), key, 0)
    value
  end

  @doc "This host's name, which browsers use to reach it."
  def hostname do
    case Ctl.World.cmd("hostname", ["-f"], stderr_to_stdout: true) do
      {out, 0} -> present(String.trim(out)) || short_hostname()
      _ -> short_hostname()
    end
  end

  defp short_hostname do
    {:ok, name} = :inet.gethostname()
    List.to_string(name)
  end

  @doc """
  The host's IANA zone name. A container's own zone is UTC, and every time
  the app stamps would otherwise be in the wrong one.
  """
  def host_timezone do
    from_timedatectl() || from_etc_timezone() || from_localtime_link() || "Etc/UTC"
  end

  defp from_timedatectl do
    case Ctl.World.cmd("timedatectl", ["show", "-p", "Timezone", "--value"], stderr_to_stdout: true) do
      {out, 0} -> present(String.trim(out))
      _ -> nil
    end
  end

  defp from_etc_timezone do
    case File.read("/etc/timezone") do
      {:ok, text} -> present(String.trim(text))
      _ -> nil
    end
  end

  defp from_localtime_link do
    with {:ok, target} <- File.read_link("/etc/localtime"),
         [_, zone] <- String.split(target, "/zoneinfo/", parts: 2) do
      present(zone)
    else
      _ -> nil
    end
  end

  @doc """
  A seed or an old script's default as a value: this host's name for
  `:hostname`, its zone for `:timezone`, anything else as it is.
  """
  def resolve_value(:hostname), do: hostname()
  def resolve_value(:timezone), do: host_timezone()
  def resolve_value(value), do: value

  @doc "The value itself, or nil for nothing or an empty string."
  def present(nil), do: nil
  def present(""), do: nil
  def present(value), do: value
end
